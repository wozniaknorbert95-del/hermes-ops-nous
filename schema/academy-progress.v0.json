{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quietforge.local/schema/academy-progress.v0.json",
  "title": "AcademyProgress",
  "description": "Honest progress export from Academy OS. Kokpit reads a copy as captured overlay — never localStorage. v0 = file contract, no API.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "tenant_id", "updated_at", "source"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "tenant_id": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 10 },
    "source": { "const": "academy-os" },
    "academy_url": {
      "type": "string",
      "description": "https URL only when set. Empty = Kokpit button disabled. Never put OIDC tokens here."
    },
    "now_card": { "type": "string" },
    "tracks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "W": { "$ref": "#/$defs/track" },
        "F": { "$ref": "#/$defs/track" }
      }
    },
    "_scratch": {
      "type": "object",
      "description": "Private DASHBOARD checkbox/radio state. Kokpit must ignore this key."
    }
  },
  "$defs": {
    "track": {
      "type": "object",
      "required": ["percent", "completed_ids"],
      "additionalProperties": false,
      "properties": {
        "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "completed_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
