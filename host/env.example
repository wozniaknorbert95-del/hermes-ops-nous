# Copy to /opt/akademia/.env on VPS (chmod 600). Never commit real values.
ACADEMY_HOST=akademia.quietforge.flexgrafik.nl
ACADEMY_LE_EMAIL=ops@flexgrafik.nl
ACADEMY_BASIC_USER=academy
ACADEMY_BASIC_HASH=
ACADEMY_PROGRESS_TOKEN=
# Klucz PUBLICZNY VAPID (jawny z definicji). Prywatny leży w /etc/akademia/vapid.env (chmod 600)
# i używa go tylko scripts/push-send.py — nigdy nie trafia do repo ani do tego pliku.
ACADEMY_VAPID_PUBLIC_KEY=
ACADEMY_PUSH_MAX_SUBS=10

# --- Hermes: mózg LLM (od 2026-09-20) ---------------------------------------
# Bez tych trzech pierwszych Hermes NIE umiera — schodzi na wbudowany silnik lokalny
# z faktów o kursie i mówi o tym wprost w czacie („lokalny silnik — <powód>").
# Klucz jest SEKRETEM: ten plik jedzie na VPS jako /opt/akademia/.env (chmod 600)
# i nigdy nie wraca do repo. docker-compose wstrzykuje wartości do kontenera vaulta.
ACADEMY_HERMES_BASE_URL=https://api.deepseek.com/v1
ACADEMY_HERMES_MODEL=deepseek-flash
ACADEMY_HERMES_API_KEY=
# Budżet MUSI pomieścić myślenie modelu (deepseek-flash to model rozumujący:
# 30–55% outputu to reasoning_content). Za niski = pusta odpowiedź przy trudnym pytaniu.
ACADEMY_HERMES_MAX_TOKENS=2500
# Krótszy niż watchdog klienta (25 s w DASHBOARD.html), żeby vault był jedynym sędzią.
ACADEMY_HERMES_TIMEOUT=20
# Sufit kosztu: twardy limit zapytań na dobę.
ACADEMY_HERMES_DAILY_CAP=200

# Hermes Ops cache (timer workflow-lab pisze ten plik na hoście).
# W kontenerze: /app/data/ops-status.json = /opt/akademia/data/ops-status.json
HERMES_OPS_STATUS=/app/data/ops-status.json
HERMES_OPS_CMD=/app/data/ops-cmd.json
# Linear READ dla bramki DoR na /ops (fail-closed). Pusta = Start 400.
LINEAR_OPS_READ=
